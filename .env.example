# Copy to .env and adjust. Never commit .env.

# PostgreSQL 16 / PostGIS 3.4 target. Matches docker-compose.yml.
DATABASE_URL=postgresql://iris:change-me@localhost:5434/iris

# Used by the integration tests (may point at the same database).
IRIS_TEST_DATABASE_URL=postgresql://iris:change-me@localhost:5434/iris

# Contact put into the User-Agent so the publisher can reach the operator.
# Required for live runs; offline runs do not need it.
WITTICH_CONTACT=ops@example.org

# docker-compose.yml reads these.
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
